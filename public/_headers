# Cloudflare Pages reads this file from the site root.
# Rules are most-specific-first; a path only picks up the block it matches.

# Nuxt fingerprints these filenames, so they can be cached forever.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Icons change rarely but keep their names — a day is long enough to help,
# short enough that a redesign is not stuck in caches.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/favicon-16.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
