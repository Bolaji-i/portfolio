# Formspree form ID — the part after /f/ in your endpoint URL.
# Copy this file to .env and fill it in. Not a secret (it ships in the client bundle),
# but it is environment-specific, so it is not committed.
NUXT_PUBLIC_FORMSPREE_ID=

# The site's public origin, no trailing slash — https://bolajiilori.com
# Used at build time to write sitemap.xml and robots.txt. Leave blank locally;
# set it in the Cloudflare Pages dashboard so preview builds don't emit a
# sitemap pointing at production.
NUXT_PUBLIC_SITE_URL=
